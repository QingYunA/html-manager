# -----------------------------------------------------------------------------
# HTML Manager Environment Configuration
# -----------------------------------------------------------------------------

# 1. 管理员访问密码（用于登录 /admin 管理中台，也可作为 API 默认 Token）
ADMIN_PASSWORD=your-secure-admin-password

# 2. 数据库连接串（支持 Vercel Postgres、Neon、Supabase 等标准 PostgreSQL）
# 本地开发时若留空，系统将自动降级为本地零配置轻量存储 (.data/db.json)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 3. 对象存储（二选一）：
# 方案 A：Vercel Blob（在 Vercel 部署时自动提供）
BLOB_READ_WRITE_TOKEN=

# 方案 B：Cloudflare R2（若使用 Cloudflare R2，填写以下 4 项，系统将自动优先使用 R2）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=html-manager

# 4. 可选配置
# API_TOKEN=custom-api-token-for-cursor-or-agents
# SESSION_SECRET=random-secret-for-jwt-signing
